{
  "name": "taxops-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first tax operations workspace with production-grade AI workflows",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:reviewer": "tsc --noEmit -p tsconfig.reviewer.json",
    "test": "vitest run",
    "test:agent-contract": "vitest run tests/agent-orchestration.contract.test.ts",
    "test:db-contract": "vitest run --config vitest.integration.config.ts",
    "test:reviewer-service": "node --import tsx scripts/run-reviewer-service-smoke.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test tests/e2e/visual-accessibility.spec.ts --update-snapshots=all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker": "node --import tsx src/worker/index.ts",
    "reviewer": "node --import tsx src/reviewer/index.ts",
    "eval": "node --conditions=react-server --import tsx scripts/run-evals.ts",
    "eval:live": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/run-live-evals.ts",
    "demo:record": "playwright test --config playwright.portfolio.config.ts && node --import tsx scripts/portfolio/build-demo-video.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:worker && npm run typecheck:reviewer && npm run test:coverage && npm run eval && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.92",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ai": "^7.0.83",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
