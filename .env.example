# Local app: omit DATABASE_URL, OBJECT_BUCKET and AI_GATEWAY_API_KEY for deterministic demo mode.
AUTH_MODE=demo

# Hosted portfolio preview only. This profile refuses to start alongside a
# database, object bucket, AI Gateway, or Reviewer service. Never enter real
# client or personal data. Leave unset for every real production environment.
# PORTFOLIO_DEMO=true

# Production database and OIDC Authorization Code + PKCE / API bearer validation.
# DATABASE_URL=postgres://taxops_app:replace-me@localhost:5432/taxops
# The web process never receives REVIEW_DATABASE_URL. A dedicated reviewer
# service holds it and independently verifies the original IdP token.
# REVIEW_SERVICE_URL=https://reviewer.service.internal
# REVIEW_SERVICE_ALLOWED_HOST=reviewer.service.internal
# REVIEW_SERVICE_ALLOW_ENCRYPTED_HTTP=false
# APP_BASE_URL=https://taxops.example.com
# OIDC_ISSUER=https://identity.example.com
# OIDC_AUDIENCE=taxops-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_AUTHORIZATION_URL=https://identity.example.com/oauth2/authorize
# OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
# OIDC_CLIENT_ID=taxops-web
# OIDC_CLIENT_SECRET=
# OIDC_REVIEW_AUDIENCE=taxops-review-api
# OIDC_REVIEW_RESOURCE_PARAMETER=resource
# OIDC_REVIEW_SCOPE=review:decide
# OIDC_REVIEW_REQUIRED_ACR=urn:example:acr:mfa
# SESSION_SECRET=
# Readiness 상세 진단을 조회하는 운영 전용 bearer token(32자 이상).
# HEALTH_DETAIL_TOKEN=

# Private S3-compatible quarantine storage. Use an IAM role in cloud deployments.
# OBJECT_BUCKET=taxops-private
AWS_REGION=ap-northeast-2
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_KMS_KEY_ID=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
DOCUMENT_PROCESSOR_URL=https://document-processor.internal/v1/extract
DOCUMENT_PROCESSOR_TOKEN=
DOCUMENT_PROCESSOR_DATA_REGION=ap-northeast-2
DOCUMENT_PROCESSOR_ALLOWED_HOSTS=document-processor.internal
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
REQUIRE_NOTIFICATION_WEBHOOK=false

# Secrets must be injected by the runtime secret manager, never committed.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
APPROVAL_TOKEN_SECRET=
REVIEW_SERVICE_SHARED_SECRET=
AI_GATEWAY_API_KEY=
AI_MODEL_ID=openai/gpt-5.6-sol
AI_VERIFIER_MODEL_ID=openai/gpt-5.6-terra
AI_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
AI_PROVIDER_DATA_REGION=ap-northeast-2
AI_INPUT_KRW_PER_MTOK=5000
AI_OUTPUT_KRW_PER_MTOK=25000

# Production DLP/NER service. The processing region must be allowed by each
# tenant policy; the bearer token is injected by the runtime secret manager.
PII_DLP_URL=https://pii-dlp.service.internal/v1/redact
PII_DLP_TOKEN=
PII_DLP_DATA_REGION=ap-northeast-2

# Production semantic classifier for indirect prompt injection. The local
# deterministic classifier is a test contract only and is never an accepted
# production readiness state.
PROMPT_INJECTION_CLASSIFIER_URL=https://injection-classifier.service.internal/v1/classify
PROMPT_INJECTION_CLASSIFIER_TOKEN=
PROMPT_INJECTION_CLASSIFIER_DATA_REGION=ap-northeast-2
PROMPT_INJECTION_CLASSIFIER_ALLOWED_HOSTS=injection-classifier.service.internal
PROMPT_INJECTION_CLASSIFIER_THRESHOLD=0.5
# Local Compose contract only. Production startup rejects this override.
TAXOPS_LOCAL_STACK=false

# MCP DNS-rebinding and browser-origin allowlists (comma-separated).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1
# Both MCP allowlists contain hostnames only, without scheme or port.
# Production example: taxops.example.com
